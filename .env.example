# AWS S3 Data Lake Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_REGION=eu-central-1
S3_BUCKET_NAME=your-unique-s3-bucket-name

# Source API Endpoints
FX_API_BASE_URL=https://api.frankfurter.app
ECOMMERCE_API_BASE_URL=https://fakestoreapi.com

# Cloud PostgreSQL Data Warehouse Configuration
DB_HOST=ep-your-instance.eu-central-1.aws.neon.tech
DB_PORT=5432
DB_NAME=dwh_db
DB_USER=your_db_username
DB_PASSWORD=your_db_password